DftSpecification(cpu_top,rtl2) {
  IjtagNetwork {
    HostScanInterface(sti_client) {
      Interface {
        design_instance : cpu_top_rtl1_tessent_sib_sti_inst;
        scan_interface : client;
      }
      Sib(sri) {
        Attributes {
          tessent_dft_function : scan_resource_instrument_host;
        }
        Sib(sri_ctrl) {
          Tdr(sri_ctrl) {
            Attributes {
              tessent_dft_function : scan_resource_instrument_dft_control;
            }
          }
        }
        Sib(occ) {
        }
        Sib(edt) {
        }
        Sib(lbist) {
        }
      }
    }
  }
  OCC {
    ijtag_host_interface : Sib(occ);
    Controller(clk1) {
      clock_intercept_nodes : clk1_p;
    }
    Controller(clk2) {
      clock_intercept_nodes : clk2_p;
    }
    Controller(clk3) {
      clock_intercept_nodes : clk3_p;
    }
    Controller(clk4) {
      clock_intercept_nodes : clk4_p;
    }
    Controller(ramclk_p) {
      clock_intercept_nodes : ramclk_p;
    }
  }
  EDT {
    ijtag_host_interface : Sib(edt);
    Controller(c1) {
      longest_chain_range : 65, 100;
      scan_chain_count : 85;
      input_channel_count : 3;
      output_channel_count : 3;
      Connections +{
        EdtChannelsIn(1) {
          port_pin_name : cpu_top_rtl1_tessent_bscan_logical_group_DEF_inst/portain_p_0_AuxIn;
        }
        EdtChannelsIn(2) {
          port_pin_name : cpu_top_rtl1_tessent_bscan_logical_group_DEF_inst/portain_p_1_AuxIn;
        }
        EdtChannelsIn(3) {
          port_pin_name : cpu_top_rtl1_tessent_bscan_logical_group_DEF_inst/portain_p_2_AuxIn;
        }
        EdtChannelsOut(1) {
          port_pin_name : cpu_top_rtl1_tessent_bscan_logical_group_DEF_inst/portbout_p_0_AuxOut;
        }
        EdtChannelsOut(2) {
          port_pin_name : cpu_top_rtl1_tessent_bscan_logical_group_DEF_inst/portbout_p_1_AuxOut;
        }
        EdtChannelsOut(3) {
          port_pin_name : cpu_top_rtl1_tessent_bscan_logical_group_DEF_inst/portbout_p_2_AuxOut;
        }
      }
    }
  }
  LogicBist {
    ijtag_host_interface : Sib(lbist);
    Controller(c1) {
      burn_in : on;
      pre_post_shift_dead_cycles : 8;
      ShiftCycles {
        max : 40;
      }
      CaptureCycles {
        max : 4;
      }
      PatternCount {
        max : 10000;
        hardware_default : 1024;
      }
      WarmupPatternCount {
        max : 512;
      }
      Connections {
        shift_clock_src : clk1;
      }
    }
    NcpIndexDecoder {
      Ncp(clk1_occ_ncp) {
        cycle(0) : OCC(clk1);
        cycle(1) : OCC(clk1);
      }
      Ncp(clk2_occ_ncp) {
        cycle(0) : OCC(clk2);
        cycle(1) : OCC(clk2);
      }
      Ncp(ALL_occ_ncp) {
        cycle(0) : OCC(clk1), OCC(clk2), Occ(clk3), Occ(clk4), Occ(ramclk_p), cpu_top_rtl1_tessent_sib_sti_inst, Bscan_occ;
      }
    }
  }
}
